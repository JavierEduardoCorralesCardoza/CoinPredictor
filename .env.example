# API keys for optional data sources (Phase 3).
# Copy this file to ".env" and fill in values. Leave blank to skip that source.
#
# COST DISCIPLINE: every paid capability is OFF by default and has its OWN
# dedicated flag (never one master switch). With all flags off the whole system
# runs at zero external API cost.

# NewsAPI (https://newsapi.org) - free tier for news sentiment
NEWSAPI_KEY=

# CryptoPanic (https://cryptopanic.com/developers/api/) - free tier alternative
CRYPTOPANIC_KEY=

# --- Paid capability flags (each gates exactly one paid thing) ---------------
# Query a PAID news provider in addition to the free RSS feeds (Phase 2).
# Requires CRYPTOPANIC_KEY or NEWSAPI_KEY; fails loudly if on but key missing.
COINPREDICTOR_PAID_NEWS=false

# Use Claude (Anthropic) for sentiment scoring instead of the free FinBERT tier
# (Phase 2). Requires ANTHROPIC_API_KEY.
COINPREDICTOR_LLM_SENTIMENT=false

# Run the LLM Judge layer at all (Phase 3). Costs real money per run; also
# subject to a hard daily spend cap (JudgeConfig.max_daily_cost_usd).
COINPREDICTOR_JUDGE_ENABLED=false

# --- Anthropic key (only used when a paid Claude path above is enabled) ------
ANTHROPIC_API_KEY=
